# Which API to use: groq, xai (Grok) or openai.
FINGUARD_PROVIDER=groq

# Fill in the key for the provider you chose.
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Leave empty for the provider's default (groq: openai/gpt-oss-120b, xai: grok-3-mini, openai: gpt-4.1-mini).
FINGUARD_MODEL=
# Leave empty for models that only accept their default temperature.
FINGUARD_TEMPERATURE=0
FINGUARD_RETRIEVAL_K=4
